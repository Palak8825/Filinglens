DATABASE_URL=sqlite+pysqlite:///./data/filinglens.db
LLM_PROVIDER=gemini          # gemini | anthropic
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_MODELS=gemini-3.5-flash,gemini-2.5-flash-lite
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
EMBED_DIM=384
DATA_DIR=./data
RERANK=1                     # 0 disables the cross-encoder (faster, lower recall)
